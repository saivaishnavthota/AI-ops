# AI-Ops Platform Backend Configuration
# Copy this file to .env and update the values
# IMPORTANT: Never commit .env files to version control!

# ===========================================
# Application
# ===========================================
APP_NAME="AI-Ops Platform"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# ===========================================
# Security (REQUIRED - NO DEFAULTS)
# ===========================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: This MUST be set - the application will fail to start without it
SECRET_KEY=

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
# SECURITY: Never use "*" wildcard in production - specify exact domains
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:7026

# ===========================================
# Celery (Background Tasks)
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# AI/ML - Anthropic Claude
# ===========================================
# Get your API key from: https://console.anthropic.com/
# IMPORTANT: Never hardcode API keys - always use environment variables
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_CLASSIFICATION_ENABLED=true
AI_SUGGESTION_ENABLED=true
AI_CORRELATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.7

# ===========================================
# Email (Optional - for password reset)
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aiops.local

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
