# AI-Ops Platform Environment Configuration
# Copy this file to .env and update the values
#
# SECURITY WARNINGS:
# - NEVER commit .env files to version control
# - NEVER use default passwords in production
# - NEVER use wildcard "*" in CORS_ORIGINS with credentials
# - Generate strong random keys for SECRET_KEY and passwords
#
# To generate secure random values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ===========================================
# Application Settings
# ===========================================
ENVIRONMENT=production
DEBUG=false

# ===========================================
# Security (REQUIRED - MUST BE SET)
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Application will NOT start without this being set!
SECRET_KEY=dev-secret-key-change-in-production-12345678

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_secret_change_me
POSTGRES_DB=aiops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL (constructed from above or override directly)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery Settings
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ===========================================
# CORS Settings
# ===========================================
# Comma-separated list of allowed origins
# SECURITY: Never use "*" wildcard - it allows any website to make authenticated requests
CORS_ORIGINS=http://localhost:7026,http://localhost:3000,http://localhost:5173

# ===========================================
# Email Configuration (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# ===========================================
# External Integrations (Optional)
# ===========================================

# Slack Integration
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# PagerDuty Integration
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Datadog Integration
DATADOG_API_KEY=
DATADOG_APP_KEY=

# AWS Integration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Integration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ===========================================
# AI/ML Configuration - Anthropic Claude
# ===========================================
# Get your API key from: https://console.anthropic.com/
# IMPORTANT: Never hardcode API keys in source code!
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_CLASSIFICATION_ENABLED=true
AI_SUGGESTION_ENABLED=true
AI_CORRELATION_ENABLED=true

# Mistral AI Configuration
# Get your API key from: https://console.mistral.ai/
# IMPORTANT: Never hardcode API keys in source code!
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ===========================================
# Server Configuration
# ===========================================
# For Contabo VPS deployment
SERVER_HOST=0.0.0.0
FRONTEND_PORT=7026
BACKEND_PORT=7027

# Domain Configuration
DOMAIN=your-domain.com
SSL_ENABLED=false
