# AI-Ops Platform Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# Application Settings
# ===========================================
ENVIRONMENT=production
DEBUG=false

# ===========================================
# Security
# ===========================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-characters

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_secret_change_me
POSTGRES_DB=aiops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL (constructed from above or override directly)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery Settings
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ===========================================
# CORS Settings
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:7026,http://frontend:7026,https://your-domain.com

# ===========================================
# Email Configuration (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com
SMTP_TLS=true

# ===========================================
# External Integrations (Optional)
# ===========================================

# Slack Integration
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# PagerDuty Integration
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# Datadog Integration
DATADOG_API_KEY=
DATADOG_APP_KEY=

# AWS Integration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Integration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ===========================================
# AI/ML Configuration (Future)
# ===========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ===========================================
# Server Configuration
# ===========================================
# For Contabo VPS deployment
SERVER_HOST=0.0.0.0
FRONTEND_PORT=7026
BACKEND_PORT=7027

# Domain Configuration
DOMAIN=your-domain.com
SSL_ENABLED=false
